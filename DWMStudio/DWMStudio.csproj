<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- The exe's icon in Explorer, the taskbar and Alt-Tab. -->
    <ApplicationIcon>Resources\DwmStudio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also as a Resource, so windows can point their Icon at it. ApplicationIcon
         alone only reaches the executable, not a Window's title bar. -->
    <Resource Include="Resources\DwmStudio.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DWM.Shared\DWM.Shared.csproj" />
  </ItemGroup>

</Project>
