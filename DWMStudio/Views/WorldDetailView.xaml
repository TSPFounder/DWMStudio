<UserControl x:Class="DWMStudio.Views.WorldDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DWMStudio.Views"
             Background="{StaticResource DwmShellBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32 24">
        <StackPanel>

            <!-- Header -->
            <TextBlock Text="{Binding World.Name}"
                       Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="{Binding World.Description}"
                       Style="{StaticResource MutedLabelStyle}"
                       TextWrapping="Wrap"
                       Margin="0 4 0 0" />

            <!-- Pipeline strip (large) -->
            <Grid Height="6" Margin="0 16 0 24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2"
                           Fill="{StaticResource DwmSysmlBrush}"
                           Opacity="{Binding SysmlStage.IsComplete,
                               Converter={StaticResource BoolToOpacityConverter}}" />
                <Rectangle Grid.Column="2" RadiusX="2" RadiusY="2"
                           Fill="{StaticResource DwmCadBrush}"
                           Opacity="{Binding CadStage.IsComplete,
                               Converter={StaticResource BoolToOpacityConverter}}" />
                <Rectangle Grid.Column="4" RadiusX="2" RadiusY="2"
                           Fill="{StaticResource DwmSimBrush}"
                           Opacity="{Binding MatlabStage.IsComplete,
                               Converter={StaticResource BoolToOpacityConverter}}" />
                <Rectangle Grid.Column="6" RadiusX="2" RadiusY="2"
                           Fill="{StaticResource DwmCoSimBrush}"
                           Opacity="{Binding CoSimStage.IsComplete,
                               Converter={StaticResource BoolToOpacityConverter}}" />
                <Rectangle Grid.Column="8" RadiusX="2" RadiusY="2"
                           Fill="{StaticResource DwmRuntimeBrush}"
                           Opacity="{Binding RuntimeStage.IsComplete,
                               Converter={StaticResource BoolToOpacityConverter}}" />
            </Grid>

            <!-- Stage panels.
                 ONE TEMPLATE, DRIVEN BY DATA. These used to be four hand-written Borders
                 with a hardcoded command each; adding FEMAP and MYSTRAN that way would have
                 meant two more of both. The tiles now come from the project's pipeline plus
                 the tool registry, so a new tool is a registry row and appears here with no
                 XAML change at all. -->
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource WorldCardStyle}" Cursor="Arrow" Margin="0 0 12 12">
                            <StackPanel Margin="16">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold" FontSize="14"
                                           Foreground="{Binding AccentColor}" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0 6 0 0" />
                                <Button Content="Open workspace"
                                        Command="{Binding DataContext.OpenWorkspaceCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0 12 0 0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============================================================
                 Contents tree.

                 A SNAPSHOT, AND IT SAYS SO. Nothing behind this view is a database: the world
                 is JSON under %APPDATA%, the artifacts are files wherever the engineering work
                 happens, and the run history is in memory. Nothing can push an update here
                 when a solver writes an .op2, so there is a Refresh button and a caption that
                 admits what it is, rather than a control that looks live and silently is not.
                 ============================================================ -->
            <TextBlock Text="Contents"
                       Style="{StaticResource SectionHeaderStyle}"
                       FontSize="16"
                       Margin="0 28 0 0" />

            <TextBlock Style="{StaticResource MutedLabelStyle}"
                       TextWrapping="Wrap"
                       Margin="0 4 0 8"
                       Text="Read from disk when this view opened; files written since then appear on Refresh. Missing files are listed in red rather than hidden, because an absent deck and an unlisted deck are different problems." />

            <Button Content="Refresh"
                    Command="{Binding RefreshTreeCommand}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0 0 0 10" />

            <Border Background="{StaticResource DwmCardBrush}"
                    BorderBrush="{StaticResource DwmDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <TreeView ItemsSource="{Binding Tree}"
                          MaxHeight="380"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <!-- Expanded by default: a missing file that only reveals itself
                                 after someone clicks is bad news hiding behind a collapse. -->
                            <Setter Property="IsExpanded" Value="True" />
                            <Setter Property="Foreground" Value="#E0E4EC" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0 2">
                                <TextBlock Text="{Binding Label}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#E0E4EC" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource DwmErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Detail}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           ToolTip="{Binding Path=Path}"
                                           Margin="10 2 0 0" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- Status line -->
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource MutedLabelStyle}"
                       Margin="0 8 0 0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
