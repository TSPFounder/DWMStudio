<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DWM.Shared\DWM.Shared.csproj" />

    <!--
      DECLARED, NOT INHERITED. DWM.Shared references both of these and a transitive
      ProjectReference is meant to flow to consumers, but FusionCheck.cs failed with CS0246
      on 'CAD' and 'Fusion' while DWMStudio.Tests -- set up identically, one ProjectReference
      to the same DWM.Shared -- compiled the same namespaces without complaint.

      Rather than work out which of the two is the anomaly, this names what it uses.
      FusionCheck builds a CadOperationSequence and calls FusionPythonScriptFactory
      directly, so the dependency is real and belongs here whether or not it also arrives
      by inheritance.
    -->
    <ProjectReference Include="..\..\CAD_Library\CAD_Library\CAD_Library.csproj" />
    <ProjectReference Include="..\..\FusionLibrary\FusionLibrary\FusionLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
  </ItemGroup>

</Project>
