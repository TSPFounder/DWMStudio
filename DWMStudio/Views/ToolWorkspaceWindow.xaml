<Window x:Class="DWMStudio.Views.ToolWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DwmShellBrush}">

    <!-- ONE WINDOW FOR EVERY TOOL. Nothing here names UModel, Fusion, MATLAB, FEMAP or
         MYSTRAN; it renders whatever ToolWorkspaceModel it was handed. That is what makes
         adding a tool a registry row rather than another XAML file. -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{Binding AccentColor}" />
            <TextBlock Text="{Binding Subtitle}"
                       Style="{StaticResource MutedLabelStyle}"
                       TextWrapping="Wrap" Margin="0 6 0 0" />
            <TextBlock Text="{Binding AvailabilityLabel}"
                       Style="{StaticResource MutedLabelStyle}"
                       Margin="0 2 0 0" />
        </StackPanel>

        <!-- The tool's own limits. Recorded in the registry precisely so it can be shown
             here: every wrong assumption on this project has been about what a tool cannot
             do rather than what it can. -->
        <Border Grid.Row="1"
                Margin="0 16 0 0" Padding="12"
                BorderBrush="{StaticResource DwmDividerBrush}" BorderThickness="1"
                Visibility="{Binding HasLimitation,
                    Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding KnownLimitation}"
                       Style="{StaticResource MutedLabelStyle}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Artifact + the three verbs -->
        <StackPanel Grid.Row="2" Margin="0 16 0 0">
            <TextBlock Text="Artifact" Style="{StaticResource MutedLabelStyle}" />
            <TextBlock Text="{Binding ArtifactLabel}"
                       Foreground="#C8D0DC" TextTrimming="CharacterEllipsis"
                       Margin="0 4 0 12" />

            <StackPanel Orientation="Horizontal">
                <Button Content="Create"
                        Command="{Binding CreateCommand}"
                        ToolTip="{Binding CreateTooltip}"
                        Style="{StaticResource GhostButtonStyle}" Margin="0 0 8 0" />
                <Button Content="Edit"
                        Command="{Binding EditCommand}"
                        ToolTip="{Binding EditTooltip}"
                        Style="{StaticResource GhostButtonStyle}" Margin="0 0 8 0" />
                <Button Content="{Binding RunLabel}"
                        Command="{Binding RunCommand}"
                        ToolTip="{Binding RunTooltip}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- Run history. A stage used to be a boolean, which cannot express "ran, passed,
             three warnings" — and that is exactly what a turbine export produces. -->
        <StackPanel Grid.Row="3" Margin="0 20 0 0">
            <TextBlock Text="Run history" Style="{StaticResource MutedLabelStyle}" />
            <ListBox ItemsSource="{Binding Runs}"
                     Background="Transparent" BorderBrush="{StaticResource DwmDividerBrush}"
                     Margin="0 6 0 0" MinHeight="140">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                           Foreground="#C8D0DC" />
                                <TextBlock Text="{Binding StartedUtc, StringFormat=' — {0:u}'}"
                                           Style="{StaticResource MutedLabelStyle}" />
                                <TextBlock Text="{Binding Duration, StringFormat=' ({0:g})'}"
                                           Style="{StaticResource MutedLabelStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ResolvedVia}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FailureMessage}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       TextWrapping="Wrap" />
                            <!-- Warnings were collected and then never rendered, which made
                                 SucceededWithWarnings a status with nothing behind it. The
                                 whole reason a run is not a boolean is that "ran, passed,
                                 three warnings" needs somewhere to say the three things. -->
                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0 4 0 0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource MutedLabelStyle}"
                                                   TextWrapping="Wrap" Margin="0 2 0 0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}"
                   Style="{StaticResource MutedLabelStyle}"
                   TextWrapping="Wrap" Margin="0 12 0 0" />
    </Grid>
</Window>
